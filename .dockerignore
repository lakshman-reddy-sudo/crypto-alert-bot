# ── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Secrets (NEVER include in image) ─────────────────────────────────────────
.env
*.env
*.pem
*.key

# ── Dev / editor files ────────────────────────────────────────────────────────
.git/
.gitignore
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# ── Test artifacts ────────────────────────────────────────────────────────────
htmlcov/
.coverage
coverage.xml

# ── Docker files (don't need to copy into the image) ─────────────────────────
Dockerfile
docker-compose.yml
.dockerignore

# ── Documentation ─────────────────────────────────────────────────────────────
README.md
Makefile
