# Copy this file to .env and fill in your values.
# Never commit .env to version control — it contains secrets.

# ── Required ─────────────────────────────────────────────────────────────────

# From: discord.com/developers/applications → Your App → Bot → Token
DISCORD_TOKEN=your_discord_bot_token_here

# From: Supabase Dashboard → Project Settings → Database → Connection string
# Use URI mode, Session pooler, port 5432 (NOT transaction mode port 6543)
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@[host]:5432/postgres


# ── Optional: Discord ─────────────────────────────────────────────────────────

# Set to your server (guild) ID for instant command sync during development.
# Leave blank for global sync (up to 1 hour propagation delay).
DEV_GUILD_ID=


# ── Optional: Database ───────────────────────────────────────────────────────

DB_MIN_POOL=2
DB_MAX_POOL=10
DB_COMMAND_TIMEOUT=30


# ── Optional: Binance ────────────────────────────────────────────────────────

BINANCE_WS_URL=wss://stream.binance.com:9443/ws/!miniTicker@arr
BINANCE_REST_URL=https://api.binance.com/api/v3/ticker/price
WS_HEARTBEAT_SECS=30
WS_READ_TIMEOUT_SECS=45
WS_RECONNECT_BASE_DELAY=5
WS_RECONNECT_MAX_DELAY=120


# ── Optional: Alert Logic ─────────────────────────────────────────────────────

# Cooldown in seconds between repeat-alert firings (default: 300 = 5 minutes)
REPEAT_COOLDOWN_SECS=300

# Maximum number of active alerts any single user can hold
MAX_ALERTS_PER_USER=50


# ── Optional: Discord Rate Limiting ─────────────────────────────────────────

DISCORD_MAX_MSG_PER_SEC=10
DISCORD_429_BACKOFF_SECS=5.0


# ── Optional: Health Check ────────────────────────────────────────────────────

HEALTHCHECK_ENABLED=true
HEALTHCHECK_HOST=0.0.0.0
HEALTHCHECK_PORT=8080


# ── Optional: Logging ─────────────────────────────────────────────────────────

# text = human-readable (dev), json = structured lines (prod/Datadog/Loki)
LOG_FORMAT=text
LOG_LEVEL=INFO


# ── Optional: Monitoring (docker-compose --profile monitoring) ────────────────

GRAFANA_PASSWORD=changeme
